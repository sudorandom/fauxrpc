package stubs

import (
	"fmt"
	"strings"

	stubsv1 "github.com/sudorandom/fauxrpc/private/gen/stubs/v1"
)

func countTotalStubs(groups []StubGroup) int {
	total := 0
	for _, g := range groups {
		total += len(g.Stubs)
	}
	return total
}

func isSelectedStub(stub *stubsv1.Stub, selected *stubsv1.Stub) bool {
	if stub == nil || selected == nil {
		return false
	}
	return stub == selected
}

func stubSearchString(stub *stubsv1.Stub) string {
	return strings.ToLower(fmt.Sprintf(
		"%s %s %s %s %s",
		stub.GetRef().GetTarget(),
		stub.GetRef().GetId(),
		stub.GetActiveIf(),
		stub.GetJson(),
		stub.GetCelContent(),
	))
}

templ List(groups []StubGroup, selectedStub *stubsv1.Stub) {
	{{ totalStubs := countTotalStubs(groups) }}
	<div class="grid grid-cols-1 lg:grid-cols-12 lg:h-[calc(100vh-3.25rem)] overflow-hidden bg-[#090d16]">
		<template id="stub-new-editor-tpl">
			@NewStub()
		</template>

		<!-- Left Pane: Registered Stubs Table -->
		<div class="lg:col-span-7 flex flex-col border-b lg:border-b-0 lg:border-r border-slate-800 h-full overflow-hidden">
			<!-- Toolbar -->
			<div class="p-3 bg-slate-900/70 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2">
				<div class="relative flex-1 min-w-[200px]">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"></path>
					</svg>
					<input
						type="search"
						id="stub-filter-input"
						aria-label="Filter stubs by target, ID, or CEL rule"
						placeholder="Filter stubs by target, ID, CEL rule, or payload..."
						oninput="filterStubList()"
						class="w-full pl-8 pr-3 py-1.5 bg-slate-950/90 border border-slate-800 rounded text-xs text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-500 transition-colors"
					/>
				</div>

				<div class="flex items-center gap-2">
					<span class="text-xs font-mono tabular-nums text-slate-400 px-2 py-1 rounded bg-slate-950 border border-slate-800">
						{ fmt.Sprintf("%d active", totalStubs) }
					</span>
					<button
						type="button"
						id="stub-new-open-btn"
						onclick="openNewStubEditor('form')"
						class="px-2.5 py-1.5 rounded bg-sky-950/90 hover:bg-sky-900 border border-sky-800/80 text-sky-300 text-xs font-medium transition-colors flex items-center gap-1"
						title="Create a new stub (Shortcut: n)"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
						</svg>
						<span>New Stub</span>
					</button>
					if totalStubs > 0 {
						<button
							type="button"
							hx-delete="/fauxrpc/stubs/"
							hx-target="#main-content"
							class="px-2.5 py-1.5 rounded bg-slate-950 hover:bg-rose-950/70 border border-slate-800 hover:border-rose-800 text-slate-300 hover:text-rose-300 text-xs font-medium transition-colors flex items-center gap-1"
							title="Remove all registered stubs"
						>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"></path>
							</svg>
							<span>Clear All</span>
						</button>
					}
				</div>
			</div>

			<!-- Stubs List -->
			<div class="flex-1 overflow-y-auto">
				if totalStubs > 0 {
					<table class="w-full text-left border-collapse">
						<thead class="sticky top-0 z-10 bg-slate-900/95 border-b border-slate-800 text-[11px] font-medium text-slate-400 select-none">
							<tr>
								<th scope="col" class="py-2 pl-3 pr-2 w-20">Mode</th>
								<th scope="col" class="py-2 px-2">Target &amp; Stub ID</th>
								<th scope="col" class="py-2 px-2">Active If (CEL)</th>
								<th scope="col" class="py-2 pl-2 pr-3 w-20 text-right">Priority</th>
							</tr>
						</thead>
						<tbody id="stubs-table-body">
							for _, group := range groups {
								for _, stub := range group.Stubs {
									{{ modeLabel, modeClass := stubModeBadge(stub) }}
									<tr
										data-stub-target={ stub.GetRef().GetTarget() }
										data-stub-id={ stub.GetRef().GetId() }
										data-stub-search={ stubSearchString(stub) }
										hx-get={ fmt.Sprintf("/fauxrpc/stubs/%s/%s", stub.GetRef().GetTarget(), stub.GetRef().GetId()) }
										hx-target="#stub-inspector-pane"
										hx-push-url="true"
										onclick="selectStubRow(this)"
										onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click()}"
										tabindex="0"
										class={ "stub-entry-row border-b border-slate-800/80 hover:bg-slate-800/50 transition-colors cursor-pointer text-xs focus:outline-none", templ.KV("selected-row", isSelectedStub(stub, selectedStub)) }
									>
										<td class="py-2.5 pl-3 pr-2 whitespace-nowrap align-middle">
											<span class={ "inline-flex items-center px-1.5 py-0.5 text-[11px] font-mono font-medium rounded", modeClass }>
												{ modeLabel }
											</span>
										</td>
										<td class="py-2.5 px-2 align-middle">
											<div class="font-mono font-semibold text-slate-100 break-all">{ stub.GetRef().GetTarget() }</div>
											<div class="font-mono text-[11px] text-sky-300 mt-0.5">{ stub.GetRef().GetId() }</div>
										</td>
										<td class="py-2.5 px-2 align-middle font-mono text-[11px]">
											if stub.GetActiveIf() != "" {
												<span class="px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-300 break-all">{ stub.GetActiveIf() }</span>
											} else {
												<span class="text-slate-400">always</span>
											}
										</td>
										<td class="py-2.5 pl-2 pr-3 whitespace-nowrap align-middle text-right font-mono tabular-nums text-slate-300">
											{ fmt.Sprintf("%d", stub.GetPriority()) }
										</td>
									</tr>
								}
							}
						</tbody>
					</table>
				} else {
					<div class="p-12 text-center">
						<div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-slate-900 border border-slate-800 text-slate-400 mb-3">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125"></path>
							</svg>
						</div>
						<h2 class="text-sm font-semibold text-slate-200">No Active Stubs Registered</h2>
						<p class="text-xs text-slate-400 max-w-md mx-auto mt-1.5 leading-relaxed">
							Stubs override schema-generated responses for specific targets or CEL conditions. Create a stub on the right, register one from any captured call in the Request Log, or pass <code class="font-mono text-slate-300">--stubs</code> when starting FauxRPC.
						</p>
						<div class="mt-4 flex items-center justify-center gap-2">
							<button
								type="button"
								onclick="openNewStubEditor('form')"
								class="px-3 py-1.5 rounded bg-sky-950/90 hover:bg-sky-900 border border-sky-800/80 text-sky-300 text-xs font-medium transition-colors inline-flex items-center gap-1.5"
							>
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
								</svg>
								<span>Create Stub</span>
							</button>
							<button
								type="button"
								onclick="openNewStubEditor('yaml')"
								class="px-3 py-1.5 rounded bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-medium transition-colors inline-flex items-center gap-1.5"
							>
								<span>Paste YAML Stub</span>
							</button>
						</div>
					</div>
				}
			</div>
		</div>

		<!-- Right Pane: Stub Inspector -->
		<div id="stub-inspector-pane" class="lg:col-span-5 flex flex-col h-full overflow-hidden bg-slate-900/20">
			if selectedStub != nil {
				@Single(selectedStub)
			} else {
				@NewStub()
			}
		</div>
	</div>
}
