package templates

templ About() {
	<div class="p-6 max-w-4xl mx-auto space-y-6">
		<div class="border-b border-slate-800 pb-4">
			<h1 class="text-xl font-semibold text-slate-100">About FauxRPC</h1>
			<p class="text-sm text-slate-400 mt-1.5 leading-relaxed">
				FauxRPC is a multi-protocol fake gRPC, gRPC-Web, Connect, and HTTP/REST server powered by Protobuf descriptors, Protovalidate constraints, and CEL-matched stubs.
			</p>
		</div>

		<div class="rounded-lg border border-slate-800 bg-slate-900/60 overflow-hidden">
			<div class="px-4 py-3 bg-slate-900 border-b border-slate-800">
				<h2 class="text-sm font-semibold text-slate-200">Documentation &amp; Project Links</h2>
			</div>
			<div class="divide-y divide-slate-800/80 text-sm">
				<a
					href="https://fauxrpc.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="px-4 py-3.5 flex items-center justify-between hover:bg-slate-800/50 transition-colors group"
				>
					<div>
						<div class="font-medium text-slate-100 group-hover:text-sky-300 transition-colors">Official Documentation (fauxrpc.com)</div>
						<div class="text-xs text-slate-400 mt-0.5">Guides for CLI flags, YAML/JSON stubs, CEL active_if rules, and Testcontainers integration.</div>
					</div>
					<span class="font-mono text-xs text-sky-400 shrink-0 ml-4">fauxrpc.com →</span>
				</a>
				<a
					href="https://github.com/sudorandom/fauxrpc"
					target="_blank"
					rel="noopener noreferrer"
					class="px-4 py-3.5 flex items-center justify-between hover:bg-slate-800/50 transition-colors group"
				>
					<div>
						<div class="font-medium text-slate-100 group-hover:text-sky-300 transition-colors">GitHub Repository</div>
						<div class="text-xs text-slate-400 mt-0.5">Browse source code, release notes, and example schemas.</div>
					</div>
					<span class="font-mono text-xs text-sky-400 shrink-0 ml-4">github.com/sudorandom/fauxrpc →</span>
				</a>
				<a
					href="https://github.com/sudorandom/fauxrpc/issues"
					target="_blank"
					rel="noopener noreferrer"
					class="px-4 py-3.5 flex items-center justify-between hover:bg-slate-800/50 transition-colors group"
				>
					<div>
						<div class="font-medium text-slate-100 group-hover:text-sky-300 transition-colors">Issue Tracker</div>
						<div class="text-xs text-slate-400 mt-0.5">Report bugs or request protocol and stubbing enhancements.</div>
					</div>
					<span class="font-mono text-xs text-sky-400 shrink-0 ml-4">Open Issues →</span>
				</a>
			</div>
		</div>
	</div>
}
