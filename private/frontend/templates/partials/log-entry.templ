package partials

import (
	"bytes"
	"encoding/json"
	"fmt"
	"net/http"
	"sort"
	"strings"

	"github.com/sudorandom/fauxrpc/private/log"
	"github.com/sudorandom/fauxrpc/private/registry"
)

// grpcStatusNames maps gRPC status codes to their string names.
var grpcStatusNames = map[int]string{
	0:  "OK",
	1:  "Canceled",
	2:  "Unknown",
	3:  "InvalidArgument",
	4:  "DeadlineExceeded",
	5:  "NotFound",
	6:  "AlreadyExists",
	7:  "PermissionDenied",
	8:  "ResourceExhausted",
	9:  "FailedPrecondition",
	10: "Aborted",
	11: "OutOfRange",
	12: "Unimplemented",
	13: "Internal",
	14: "Unavailable",
	15: "DataLoss",
	16: "Unauthenticated",
}

func getStatusName(status int, protocol string) string {
	if protocol == "HTTP" || status >= 100 {
		text := http.StatusText(status)
		if text != "" {
			return fmt.Sprintf("%d %s", status, text)
		}
		return fmt.Sprintf("%d", status)
	}
	if name, ok := grpcStatusNames[status]; ok {
		if status == 0 {
			return "OK"
		}
		return fmt.Sprintf("%d %s", status, name)
	}
	return fmt.Sprintf("CODE_%d", status)
}

func isErrorStatus(status int, protocol string) bool {
	if protocol == "HTTP" || status >= 100 {
		return status >= 400
	}
	return status != 0
}

func getStatusColor(status int, protocol string) string {
	if protocol == "HTTP" || status >= 100 {
		switch {
		case status >= 200 && status < 300:
			return "bg-emerald-950/80 text-emerald-300 border border-emerald-800/80"
		case status >= 300 && status < 400:
			return "bg-sky-950/80 text-sky-300 border border-sky-800/80"
		case status >= 400 && status < 500:
			return "bg-amber-950/80 text-amber-300 border border-amber-800/80"
		case status >= 500:
			return "bg-rose-950/80 text-rose-300 border border-rose-800/80"
		default:
			return "bg-slate-800 text-slate-300 border border-slate-700"
		}
	}
	switch status {
	case 0:
		return "bg-emerald-950/80 text-emerald-300 border border-emerald-800/80"
	case 1, 3, 5, 6, 9, 10, 11, 15:
		return "bg-amber-950/80 text-amber-300 border border-amber-800/80"
	case 2, 4, 7, 8, 12, 13, 14, 16:
		return "bg-rose-950/80 text-rose-300 border border-rose-800/80"
	default:
		return "bg-slate-800 text-slate-300 border border-slate-700"
	}
}

func getProtocolColor(protocol string) string {
	switch protocol {
	case "gRPC":
		return "bg-sky-950/80 text-sky-300 border border-sky-800/70"
	case "gRPC-Web":
		return "bg-amber-950/80 text-amber-300 border border-amber-800/70"
	case "ConnectRPC", "Connect":
		return "bg-indigo-950/80 text-indigo-300 border border-indigo-800/70"
	case "HTTP":
		return "bg-violet-950/80 text-violet-300 border border-violet-800/70"
	default:
		return "bg-slate-800 text-slate-300 border border-slate-700"
	}
}

func formatHeaders(raw json.RawMessage) string {
	if len(raw) == 0 || string(raw) == "null" {
		return "n/a"
	}

	var headers map[string]json.RawMessage
	if err := json.Unmarshal(raw, &headers); err != nil {
		return string(raw)
	}

	if len(headers) == 0 {
		return "n/a"
	}

	keys := make([]string, 0, len(headers))
	for k := range headers {
		keys = append(keys, k)
	}
	sort.Strings(keys)

	var builder strings.Builder
	for _, k := range keys {
		vRaw := headers[k]

		var values []string
		if err := json.Unmarshal(vRaw, &values); err == nil {
			for _, v := range values {
				builder.WriteString(fmt.Sprintf("%s: %s\n", k, v))
			}
			continue
		}

		var value string
		if err := json.Unmarshal(vRaw, &value); err == nil {
			builder.WriteString(fmt.Sprintf("%s: %s\n", k, value))
			continue
		}

		builder.WriteString(fmt.Sprintf("%s: %s\n", k, string(vRaw)))
	}

	return strings.TrimSpace(builder.String())
}

func prettyPrintJSON(data json.RawMessage) string {
	if len(data) == 0 || string(data) == "null" {
		return "{}"
	}

	var indentedJSON bytes.Buffer
	if err := json.Indent(&indentedJSON, data, "", "  "); err != nil {
		return string(data)
	}
	return indentedJSON.String()
}

func entrySearchText(entry *log.LogEntry) string {
	return strings.ToLower(fmt.Sprintf(
		"%s %s %s %s %s %d %s %s",
		entry.ID,
		entry.Service,
		entry.Method,
		entry.ClientProtocol,
		getStatusName(entry.Status, entry.ClientProtocol),
		entry.Status,
		string(entry.RequestBody),
		string(entry.ResponseBody),
	))
}

templ LogEntry(entry *log.LogEntry, reg registry.ServiceRegistry) {
	{{ pkgName, svcName := splitService(entry.Service) }}
	<tr
		id={ fmt.Sprintf("log-row-%s", entry.ID) }
		data-entry-id={ entry.ID }
		data-status={ fmt.Sprintf("%d", entry.Status) }
		data-is-error={ fmt.Sprintf("%t", isErrorStatus(entry.Status, entry.ClientProtocol)) }
		data-protocol={ entry.ClientProtocol }
		data-search={ entrySearchText(entry) }
		onclick={ templ.ComponentScript{Call: fmt.Sprintf("selectLogEntry(this, '%s')", entry.ID)} }
		tabindex="0"
		onkeydown={ templ.ComponentScript{Call: fmt.Sprintf("if(event.key==='Enter'||event.key===' '){event.preventDefault();selectLogEntry(this, '%s')}", entry.ID)} }
		class="log-entry-row group border-b border-slate-800/80 hover:bg-slate-800/50 transition-colors cursor-pointer text-xs focus:outline-none"
	>
		<td class="py-2.5 pl-3 pr-2 whitespace-nowrap align-middle">
			<span class={ "inline-flex items-center px-1.5 py-0.5 text-[11px] font-mono font-medium rounded tabular-nums", getStatusColor(entry.Status, entry.ClientProtocol) }>
				{ getStatusName(entry.Status, entry.ClientProtocol) }
			</span>
		</td>
		<td class="py-2.5 px-2 whitespace-nowrap align-middle">
			<span class={ "inline-flex items-center px-1.5 py-0.5 text-[11px] font-mono font-medium rounded", getProtocolColor(entry.ClientProtocol) }>
				{ entry.ClientProtocol }
			</span>
		</td>
		<td class="py-2.5 px-2 align-middle min-w-[220px]">
			if entry.ClientProtocol == "HTTP" && entry.Service == "" {
				<div class="font-mono font-semibold text-slate-100 break-all">{ entry.Method }</div>
			} else {
				<div class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5">
					<span class="font-mono font-semibold text-slate-100">{ svcName }</span>
					<span class="text-slate-500 font-mono">/</span>
					<span class="font-mono font-semibold text-sky-300">{ entry.Method }</span>
					if pkgName != "" {
						<span class="font-mono text-[11px] text-slate-400 ml-1">({ pkgName })</span>
					}
				</div>
			}
		</td>
		<td class="py-2.5 px-2 whitespace-nowrap align-middle">
			if len(entry.StubsUsed) > 0 {
				<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-sky-950/70 border border-sky-800/60 text-[11px] font-mono text-sky-300" title="Custom stub matched">
					<span>{ fmt.Sprintf("%d stub", len(entry.StubsUsed)) }</span>
				</span>
			} else {
				<span class="text-[11px] font-mono text-slate-400" title="Generated from schema & Protovalidate">auto</span>
			}
		</td>
		<td class="py-2.5 px-2 whitespace-nowrap align-middle text-right font-mono tabular-nums text-slate-300">
			{ formatCompactDuration(entry.Duration) }
		</td>
		<td class="py-2.5 pl-2 pr-3 whitespace-nowrap align-middle text-right font-mono tabular-nums text-slate-400">
			{ entry.Timestamp.Format("15:04:05.000") }
			<template id={ fmt.Sprintf("log-detail-tpl-%s", entry.ID) } class="log-detail-tpl">
				@LogEntryInspector(entry, reg)
			</template>
		</td>
	</tr>
}

templ LogEntryInspector(entry *log.LogEntry, reg registry.ServiceRegistry) {
	<div class="flex flex-col h-full bg-slate-900/40">
		<!-- Inspector Header -->
		<div class="p-4 border-b border-slate-800 bg-slate-900/80 space-y-3">
			<div class="flex items-center justify-between gap-2 flex-wrap">
				<div class="flex items-center gap-2 flex-wrap">
					<span class={ "px-2 py-0.5 text-xs font-mono font-semibold rounded tabular-nums", getStatusColor(entry.Status, entry.ClientProtocol) }>
						{ getStatusName(entry.Status, entry.ClientProtocol) }
					</span>
					<span class={ "px-2 py-0.5 text-xs font-mono font-medium rounded", getProtocolColor(entry.ClientProtocol) }>
						{ entry.ClientProtocol }
					</span>
					<span class="text-xs font-mono tabular-nums text-slate-300 px-1.5 py-0.5 rounded bg-slate-800/80 border border-slate-700/70" title="Request execution latency">
						{ entry.Duration.String() }
					</span>
				</div>
				<div class="flex items-center gap-2 text-xs font-mono tabular-nums text-slate-400">
					<span title="Timestamp">{ entry.Timestamp.Format("2006-01-02 15:04:05.000") }</span>
				</div>
			</div>

			<div class="flex items-center justify-between gap-2 bg-slate-950/80 border border-slate-800 rounded px-3 py-2">
				<div class="font-mono text-xs text-slate-100 break-all select-all" id={ fmt.Sprintf("entry-path-%s", entry.ID) }>
					if entry.ClientProtocol == "HTTP" && entry.Service == "" {
						{ entry.Method }
					} else {
						<span class="text-slate-400">{ entry.Service }/</span><span class="text-sky-300 font-semibold">{ entry.Method }</span>
					}
				</div>
				<div class="flex items-center gap-1.5 shrink-0">
					<button
						type="button"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('entry-path-%s', this)", entry.ID)} }
						class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-medium transition-colors flex items-center gap-1"
						title="Copy full RPC path"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a2.25 2.25 0 01-2.25 2.25h-1.5a2.25 2.25 0 01-2.25-2.25v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"></path>
						</svg>
						<span>Copy Path</span>
					</button>
					<button
						type="button"
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("switchInspectorTab('%s', 'yaml')", entry.ID)} }
						class="px-2 py-1 rounded bg-sky-950/90 hover:bg-sky-900 border border-sky-800/80 text-sky-300 text-[11px] font-medium transition-colors flex items-center gap-1"
						title="View and export YAML stub for this call"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"></path>
						</svg>
						<span>YAML Stub</span>
					</button>
				</div>
			</div>

			<!-- Inspector Tabs -->
			<div class="flex items-center gap-1 pt-1 border-b border-slate-800 -mb-4">
				<button
					type="button"
					id={ fmt.Sprintf("insp-tab-payloads-%s", entry.ID) }
					data-insp-tab="payloads"
					onclick={ templ.ComponentScript{Call: fmt.Sprintf("switchInspectorTab('%s', 'payloads')", entry.ID)} }
					title="Payloads (Shortcut: 1)"
					class="insp-tab-btn px-3 py-2 text-xs font-medium border-b-2 border-sky-400 text-sky-300 transition-colors"
				>
					Payloads
				</button>
				<button
					type="button"
					id={ fmt.Sprintf("insp-tab-headers-%s", entry.ID) }
					data-insp-tab="headers"
					onclick={ templ.ComponentScript{Call: fmt.Sprintf("switchInspectorTab('%s', 'headers')", entry.ID)} }
					title="Headers (Shortcut: 2)"
					class="insp-tab-btn px-3 py-2 text-xs font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5"
				>
					<span>Headers</span>
					<span class="px-1.5 py-0.2 rounded bg-slate-800 text-[10px] font-mono text-slate-300 tabular-nums">
						{ fmt.Sprintf("%d", len(parseHeaderPairs(entry.RequestHeaders))+len(parseHeaderPairs(entry.ResponseHeaders))) }
					</span>
				</button>
				<button
					type="button"
					id={ fmt.Sprintf("insp-tab-mocks-%s", entry.ID) }
					data-insp-tab="mocks"
					onclick={ templ.ComponentScript{Call: fmt.Sprintf("switchInspectorTab('%s', 'mocks')", entry.ID)} }
					title="Mocks Used (Shortcut: 3)"
					class="insp-tab-btn px-3 py-2 text-xs font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5"
				>
					<span>Mocks Used</span>
					<span class="px-1.5 py-0.2 rounded bg-slate-800 text-[10px] font-mono text-slate-300 tabular-nums">
						{ fmt.Sprintf("%d", len(entry.StubsUsed)) }
					</span>
				</button>
				<button
					type="button"
					id={ fmt.Sprintf("insp-tab-yaml-%s", entry.ID) }
					data-insp-tab="yaml"
					onclick={ templ.ComponentScript{Call: fmt.Sprintf("switchInspectorTab('%s', 'yaml')", entry.ID)} }
					title="YAML Stub (Shortcut: 4)"
					class="insp-tab-btn px-3 py-2 text-xs font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors"
				>
					YAML Stub
				</button>
			</div>
		</div>

		<!-- Inspector Body -->
		<div class="flex-1 overflow-y-auto p-4 space-y-5">
			<!-- TAB 1: PAYLOADS -->
			<div id={ fmt.Sprintf("insp-panel-payloads-%s", entry.ID) } data-insp-panel="payloads" class="insp-panel space-y-5">
				<!-- Request Payload / Frames -->
				<div class="rounded-lg border border-slate-800 bg-slate-950/60 overflow-hidden">
					if len(entry.RequestFrames) > 0 {
						<div class="px-3 py-2 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
							<span class="text-xs font-semibold text-slate-200">Request Stream ({ fmt.Sprintf("%d frames", len(entry.RequestFrames)) })</span>
						</div>
						<div class="divide-y divide-slate-800/80">
							for i, frame := range entry.RequestFrames {
								<div class="p-3 space-y-1.5">
									<div class="flex items-center justify-between">
										<span class="text-[11px] font-mono text-slate-400">Frame #{ fmt.Sprintf("%d", i+1) }</span>
										<button
											type="button"
											onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('request-frame-%s-%d', this)", entry.ID, i)} }
											class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] flex items-center gap-1 transition-colors"
										>
											<span>Copy</span>
										</button>
									</div>
									<pre id={ fmt.Sprintf("request-frame-%s-%d", entry.ID, i) } class="text-xs font-mono text-slate-200 overflow-x-auto"><code class="language-json">{ prettyPrintJSON(frame) }</code></pre>
								</div>
							}
						</div>
					} else {
						<div class="px-3 py-2 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
							<span class="text-xs font-semibold text-slate-200">Request Payload</span>
							<button
								type="button"
								onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('request-body-%s', this)", entry.ID)} }
								class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-medium flex items-center gap-1 transition-colors"
								title="Copy request JSON"
							>
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a2.25 2.25 0 01-2.25 2.25h-1.5a2.25 2.25 0 01-2.25-2.25v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"></path>
								</svg>
								<span>Copy JSON</span>
							</button>
						</div>
						<pre id={ fmt.Sprintf("request-body-%s", entry.ID) } class="p-3 text-xs font-mono text-slate-200 overflow-x-auto max-h-72 overflow-y-auto"><code class="language-json">{ prettyPrintJSON(entry.RequestBody) }</code></pre>
					}
				</div>

				<!-- Response Payload / Frames -->
				<div class="rounded-lg border border-slate-800 bg-slate-950/60 overflow-hidden">
					if len(entry.ResponseFrames) > 0 {
						<div class="px-3 py-2 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
							<span class="text-xs font-semibold text-slate-200">Response Stream ({ fmt.Sprintf("%d frames", len(entry.ResponseFrames)) })</span>
						</div>
						<div class="divide-y divide-slate-800/80">
							for i, frame := range entry.ResponseFrames {
								<div class="p-3 space-y-1.5">
									<div class="flex items-center justify-between">
										<span class="text-[11px] font-mono text-slate-400">Frame #{ fmt.Sprintf("%d", i+1) }</span>
										<button
											type="button"
											onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('response-frame-%s-%d', this)", entry.ID, i)} }
											class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] flex items-center gap-1 transition-colors"
										>
											<span>Copy</span>
										</button>
									</div>
									<pre id={ fmt.Sprintf("response-frame-%s-%d", entry.ID, i) } class="text-xs font-mono text-slate-200 overflow-x-auto"><code class="language-json">{ prettyPrintJSON(frame) }</code></pre>
								</div>
							}
						</div>
					} else {
						<div class="px-3 py-2 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
							if isErrorStatus(entry.Status, entry.ClientProtocol) {
								<span class="text-xs font-semibold text-rose-300">Error Response Payload</span>
							} else {
								<span class="text-xs font-semibold text-slate-200">Response Payload</span>
							}
							<button
								type="button"
								onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('response-body-%s', this)", entry.ID)} }
								class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-medium flex items-center gap-1 transition-colors"
								title="Copy response JSON"
							>
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a2.25 2.25 0 01-2.25 2.25h-1.5a2.25 2.25 0 01-2.25-2.25v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"></path>
								</svg>
								<span>Copy JSON</span>
							</button>
						</div>
						<pre id={ fmt.Sprintf("response-body-%s", entry.ID) } class="p-3 text-xs font-mono text-slate-200 overflow-x-auto max-h-80 overflow-y-auto"><code class="language-json">{ prettyPrintJSON(entry.ResponseBody) }</code></pre>
					}
				</div>
			</div>

			<!-- TAB 2: HEADERS -->
			<div id={ fmt.Sprintf("insp-panel-headers-%s", entry.ID) } data-insp-panel="headers" class="insp-panel hidden space-y-5">
				<div class="rounded-lg border border-slate-800 bg-slate-950/60 overflow-hidden">
					<div class="px-3 py-2 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
						<span class="text-xs font-semibold text-slate-200">Request Headers</span>
						<button
							type="button"
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('req-headers-raw-%s', this)", entry.ID)} }
							class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] transition-colors"
						>
							Copy
						</button>
					</div>
					<pre id={ fmt.Sprintf("req-headers-raw-%s", entry.ID) } class="hidden">{ formatHeaders(entry.RequestHeaders) }</pre>
					if pairs := parseHeaderPairs(entry.RequestHeaders); len(pairs) > 0 {
						<table class="w-full text-xs text-left">
							<tbody class="divide-y divide-slate-800/70 font-mono">
								for _, pair := range pairs {
									<tr>
										<th scope="row" class="py-1.5 px-3 font-medium text-slate-400 align-top w-2/5 break-all">{ pair.Key }</th>
										<td class="py-1.5 px-3 text-slate-200 break-all">{ pair.Value }</td>
									</tr>
								}
							</tbody>
						</table>
					} else {
						<div class="p-3 text-xs text-slate-400">No request headers recorded.</div>
					}
				</div>

				<div class="rounded-lg border border-slate-800 bg-slate-950/60 overflow-hidden">
					<div class="px-3 py-2 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
						<span class="text-xs font-semibold text-slate-200">Response Headers &amp; Trailers</span>
						<button
							type="button"
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('resp-headers-raw-%s', this)", entry.ID)} }
							class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] transition-colors"
						>
							Copy
						</button>
					</div>
					<pre id={ fmt.Sprintf("resp-headers-raw-%s", entry.ID) } class="hidden">{ formatHeaders(entry.ResponseHeaders) }</pre>
					if pairs := parseHeaderPairs(entry.ResponseHeaders); len(pairs) > 0 {
						<table class="w-full text-xs text-left">
							<tbody class="divide-y divide-slate-800/70 font-mono">
								for _, pair := range pairs {
									<tr>
										<th scope="row" class="py-1.5 px-3 font-medium text-slate-400 align-top w-2/5 break-all">{ pair.Key }</th>
										<td class="py-1.5 px-3 text-slate-200 break-all">{ pair.Value }</td>
									</tr>
								}
							</tbody>
						</table>
					} else {
						<div class="p-3 text-xs text-slate-400">No response headers recorded.</div>
					}
				</div>
			</div>

			<!-- TAB 3: MOCKS USED -->
			<div id={ fmt.Sprintf("insp-panel-mocks-%s", entry.ID) } data-insp-panel="mocks" class="insp-panel hidden space-y-4">
				if len(entry.StubsUsed) > 0 {
					<div class="rounded-lg border border-slate-800 bg-slate-950/60 overflow-hidden">
						<div class="px-3 py-2 bg-slate-900/90 border-b border-slate-800">
							<span class="text-xs font-semibold text-slate-200">Matched Stubs ({ fmt.Sprintf("%d", len(entry.StubsUsed)) })</span>
						</div>
						<table class="w-full text-xs text-left">
							<thead class="bg-slate-900/50 text-slate-400 border-b border-slate-800">
								<tr>
									<th scope="col" class="py-2 px-3 font-medium">Target</th>
									<th scope="col" class="py-2 px-3 font-medium">Stub ID</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/70 font-mono">
								for _, stub := range entry.StubsUsed {
									<tr
										hx-get={ fmt.Sprintf("/fauxrpc/stubs/%s/%s", stub.GetName(), stub.GetID()) }
										hx-target="#main-content"
										hx-push-url="true"
										onclick="setActiveNavTab('nav-stubs')"
										tabindex="0"
										role="link"
										onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click()}"
										title={ fmt.Sprintf("Inspect stub %s", stub.GetID()) }
										class="hover:bg-slate-800/60 transition-colors cursor-pointer group"
									>
										<td class="py-2.5 px-3 text-slate-200 group-hover:text-slate-100 break-all">{ fmt.Sprintf("%s", stub.GetName()) }</td>
										<td class="py-2.5 px-3 text-sky-300 group-hover:text-sky-200">{ stub.GetID() }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					<div class="rounded-lg border border-slate-800 bg-slate-950/60 p-4 space-y-3">
						<div class="text-xs font-semibold text-slate-200">Synthesized from Schema &amp; Protovalidate</div>
						<p class="text-xs text-slate-400 leading-relaxed">
							No static stub was matched for this call. FauxRPC generated the response dynamically from the Protobuf message descriptor and any Protovalidate field constraints.
						</p>
						<button
							type="button"
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("switchInspectorTab('%s', 'yaml')", entry.ID)} }
							class="px-3 py-1.5 rounded bg-sky-950/90 hover:bg-sky-900 border border-sky-800 text-sky-300 text-xs font-medium transition-colors inline-flex items-center gap-1.5"
						>
							<span>Pin as YAML Stub</span>
						</button>
					</div>
				}
			</div>

			<!-- TAB 4: YAML STUB -->
			<div id={ fmt.Sprintf("insp-panel-yaml-%s", entry.ID) } data-insp-panel="yaml" class="insp-panel hidden space-y-3">
				<div class="rounded-lg border border-slate-800 bg-slate-950/70 overflow-hidden">
					<div class="px-3 py-2.5 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between gap-2 flex-wrap">
						<div class="flex items-center gap-2">
							<span class="text-xs font-semibold text-slate-200">YAML Stub</span>
							<span class="text-[11px] font-mono text-slate-400 px-1.5 py-0.5 rounded bg-slate-950 border border-slate-800">
								{ stubFilename(entry) }
							</span>
						</div>
						<div class="flex items-center gap-1.5 flex-wrap">
							<button
								type="button"
								onclick={ templ.ComponentScript{Call: fmt.Sprintf("registerStubFromYAML('yaml-stub-%s', this)", entry.ID)} }
								class="px-2.5 py-1 rounded bg-emerald-950/90 hover:bg-emerald-900 border border-emerald-800 text-emerald-300 text-xs font-medium transition-colors flex items-center gap-1.5"
								title="Register this stub directly in the running FauxRPC server"
							>
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
								</svg>
								<span>Register Stub</span>
							</button>
							<button
								type="button"
								onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('yaml-stub-%s', this)", entry.ID)} }
								class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-medium transition-colors flex items-center gap-1.5"
								title="Copy YAML Stub to clipboard"
							>
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a2.25 2.25 0 01-2.25 2.25h-1.5a2.25 2.25 0 01-2.25-2.25v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"></path>
								</svg>
								<span>Copy</span>
							</button>
							<button
								type="button"
								onclick={ templ.ComponentScript{Call: fmt.Sprintf("downloadStubYAML('yaml-stub-%s', '%s', this)", entry.ID, stubFilename(entry))} }
								class="px-2.5 py-1 rounded bg-sky-950/90 hover:bg-sky-900 border border-sky-800 text-sky-300 text-xs font-medium transition-colors flex items-center gap-1.5"
								title="Download YAML Stub file"
							>
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
								</svg>
								<span>Download</span>
							</button>
						</div>
					</div>
					<div id={ fmt.Sprintf("yaml-stub-feedback-%s", entry.ID) } class="hidden px-3 py-2 text-xs border-b border-slate-800"></div>
					<pre id={ fmt.Sprintf("yaml-stub-%s", entry.ID) } class="p-3 text-xs font-mono text-slate-200 overflow-x-auto max-h-[420px] overflow-y-auto"><code class="language-yaml">{ generateStubYAML(entry, reg) }</code></pre>
				</div>
			</div>
		</div>
	</div>
}
