package partials

import (
	"github.com/sudorandom/fauxrpc/private/log"
	"github.com/sudorandom/fauxrpc/private/registry"
)

templ RequestLogInspectorEmpty() {
	<div class="flex-1 flex flex-col items-center justify-center p-8 text-center">
		<div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-slate-900 border border-slate-800 text-slate-400 mb-3">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m5.231 13.481L15 17.25m-4.5-15H5.625c-.621 0-1.125.504-1.125 1.125v16.5c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9zm3.75 11.625a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"></path>
			</svg>
		</div>
		<h2 class="text-sm font-semibold text-slate-200">Request Inspector</h2>
		<p class="text-xs text-slate-400 max-w-xs mt-1 leading-relaxed">
			Select any request row from the stream (or press <kbd class="px-1.5 py-0.5 text-[11px] font-mono bg-slate-900 border border-slate-700 rounded text-slate-300">j</kbd> / <kbd class="px-1.5 py-0.5 text-[11px] font-mono bg-slate-900 border border-slate-700 rounded text-slate-300">k</kbd>) to inspect payloads, headers, matched stubs, or export a YAML stub.
		</p>
	</div>
}

templ RequestLog(entries []*log.LogEntry, reg registry.ServiceRegistry) {
	<div class="grid grid-cols-1 lg:grid-cols-12 lg:h-[calc(100vh-3.25rem)] overflow-hidden bg-[#090d16]">
		<template id="log-inspector-empty-tpl">
			@RequestLogInspectorEmpty()
		</template>

		<!-- Left Pane: Live Request Stream Table -->
		<div class="lg:col-span-7 flex flex-col border-b lg:border-b-0 lg:border-r border-slate-800 h-full overflow-hidden">
			<!-- Filter & Stream Toolbar -->
			<div class="p-3 bg-slate-900/70 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2">
				<div class="relative flex-1 min-w-[200px]">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"></path>
					</svg>
					<input
						type="search"
						id="log-filter-input"
						aria-label="Filter requests by service, method, payload, or status"
						placeholder="Filter by service, method, payload, status... (Press /)"
						oninput="applyLogFilters()"
						class="w-full pl-8 pr-3 py-1.5 bg-slate-950/90 border border-slate-800 rounded text-xs text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-500 transition-colors"
					/>
				</div>

				<div class="flex items-center gap-1.5 flex-wrap">
					<!-- Status Filter Segmented Control -->
					<div class="inline-flex rounded bg-slate-950 p-0.5 border border-slate-800 text-xs" role="group" aria-label="Filter by status">
						<button
							type="button"
							data-status-filter="all"
							onclick="setLogStatusFilter('all', this)"
							class="log-status-filter-btn px-2 py-1 rounded text-[11px] font-medium bg-slate-800 text-slate-100 transition-colors"
						>
							All
						</button>
						<button
							type="button"
							data-status-filter="ok"
							onclick="setLogStatusFilter('ok', this)"
							class="log-status-filter-btn px-2 py-1 rounded text-[11px] font-medium text-slate-400 hover:text-slate-200 transition-colors"
						>
							OK
						</button>
						<button
							type="button"
							data-status-filter="error"
							onclick="setLogStatusFilter('error', this)"
							class="log-status-filter-btn px-2 py-1 rounded text-[11px] font-medium text-slate-400 hover:text-slate-200 transition-colors"
						>
							Errors
						</button>
					</div>

					<!-- Protocol Filter -->
					<select
						id="log-protocol-filter"
						aria-label="Filter by client protocol"
						onchange="applyLogFilters()"
						class="px-2 py-1.5 bg-slate-950 border border-slate-800 rounded text-xs text-slate-200 focus:outline-none focus:border-sky-500"
					>
						<option value="all">All Protocols</option>
						<option value="gRPC">gRPC</option>
						<option value="gRPC-Web">gRPC-Web</option>
						<option value="ConnectRPC">Connect</option>
						<option value="HTTP">HTTP</option>
					</select>

					<!-- Clear Log Button -->
					<button
						type="button"
						onclick="clearRequestLog()"
						class="px-2.5 py-1.5 rounded bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-slate-100 text-xs font-medium transition-colors flex items-center gap-1"
						title="Clear request log history (Shortcut: x)"
					>
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"></path>
						</svg>
						<span>Clear</span>
					</button>
				</div>
			</div>

			<!-- Request Stream Table -->
			<div class="flex-1 overflow-y-auto relative" hx-ext="sse" sse-connect="/fauxrpc/sse/logs">
				<table class="w-full text-left border-collapse">
					<thead class="sticky top-0 z-10 bg-slate-900/95 border-b border-slate-800 text-[11px] font-medium text-slate-400 select-none">
						<tr>
							<th scope="col" class="py-2 pl-3 pr-2 w-24">Status</th>
							<th scope="col" class="py-2 px-2 w-24">Protocol</th>
							<th scope="col" class="py-2 px-2">Service / Method</th>
							<th scope="col" class="py-2 px-2 w-20">Source</th>
							<th scope="col" class="py-2 px-2 w-20 text-right">Latency</th>
							<th scope="col" class="py-2 pl-2 pr-3 w-28 text-right">Time</th>
						</tr>
					</thead>
					<tbody id="log-entries" sse-swap="Request" hx-swap="afterbegin">
						for _, entry := range entries {
							@LogEntry(entry, reg)
						}
					</tbody>
				</table>

				<!-- Empty State -->
				<div id="log-empty-state" class={ "p-12 text-center", templ.KV("hidden", len(entries) > 0) }>
					<div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-slate-900 border border-slate-800 text-sky-400 mb-3">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"></path>
						</svg>
					</div>
					<h2 class="text-sm font-semibold text-slate-200">Listening for Live RPC &amp; HTTP Traffic</h2>
					<p class="text-xs text-slate-400 max-w-md mx-auto mt-1.5 leading-relaxed">
						Incoming gRPC, gRPC-Web, Connect, and transcoded HTTP requests will stream here automatically in real time.
					</p>
					<div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded bg-slate-900 border border-slate-800 font-mono text-xs text-slate-300">
						<span class="text-slate-400">$</span>
						<span>fauxrpc curl http://127.0.0.1:6660</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Right Pane: Sticky Request Inspector -->
		<div id="log-inspector-pane" class="lg:col-span-5 flex flex-col h-full overflow-hidden bg-slate-900/20">
			@RequestLogInspectorEmpty()
		</div>
	</div>
}
