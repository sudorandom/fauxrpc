package browser

import "fmt"

type SchemaFileEntry struct {
	Path         string
	FileName     string
	Package      string
	ServiceCount int
	MessageCount int
	EnumCount    int
}

type SchemaPackageGroup struct {
	Package string
	Files   []SchemaFileEntry
}

templ FileContent(packageName string, filePath string, fileName string, content string) {
	<div class="flex flex-col h-full bg-slate-900/40">
		<!-- File Viewer Header -->
		<div class="p-4 border-b border-slate-800 bg-slate-900/80 flex items-center justify-between gap-3 flex-wrap">
			<div class="space-y-1 min-w-0">
				<div class="flex items-center gap-2 flex-wrap">
					<span class="px-2 py-0.5 text-xs font-mono font-semibold rounded bg-sky-950/80 text-sky-300 border border-sky-800/80">
						{ packageName }
					</span>
					<span class="font-mono text-xs text-slate-200 font-semibold truncate">{ filePath }</span>
				</div>
			</div>
			<div class="flex items-center gap-1.5 shrink-0">
				<button
					type="button"
					onclick="copyToClipboard('proto-source-code', this)"
					class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-medium transition-colors flex items-center gap-1.5"
					title="Copy .proto definition"
				>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a2.25 2.25 0 01-2.25 2.25h-1.5a2.25 2.25 0 01-2.25-2.25v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"></path>
					</svg>
					<span>Copy .proto</span>
				</button>
				<button
					type="button"
					onclick={ templ.ComponentScript{Call: fmt.Sprintf("downloadStubYAML('proto-source-code', '%s', this)", fileName)} }
					class="px-2.5 py-1 rounded bg-sky-950/90 hover:bg-sky-900 border border-sky-800 text-sky-300 text-xs font-medium transition-colors flex items-center gap-1.5"
					title="Download .proto file"
				>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-3.5 h-3.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
					</svg>
					<span>Download</span>
				</button>
			</div>
		</div>

		<!-- Proto Source Content -->
		<div class="flex-1 overflow-y-auto p-4 bg-slate-950/50">
			<pre id="proto-source-code" class="text-xs font-mono text-slate-200 overflow-x-auto leading-relaxed"><code class="language-protobuf">{ content }</code></pre>
		</div>
	</div>
}
